<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- This used to inherit from com.google.android.material, pulling in a whole
         View-based library just to paint a window background. The UI is pure Compose
         and MaterialTheme does the real work, so the platform theme is enough. -->
    <style name="Theme.PixelMirroring" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
